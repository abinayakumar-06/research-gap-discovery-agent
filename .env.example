# ==============================================================================
# Research Literature Synthesis & Research-Gap Discovery Platform
# Configuration Environment Variables
# ==============================================================================

# LLM Configuration
# Options: "local" (default offline fallback), "openai", "gemini", "groq"
LLM_PROVIDER=local

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Key (Required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External Literature Verification Provider
# Options: "crossref" (default), "openalex", "semantic_scholar", "europe_pmc", "local_benchmark"
SCHOLAR_SEARCH_PROVIDER=crossref
SEMANTIC_SCHOLAR_API_KEY=your_optional_s2_api_key_here

# Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
MAX_FILE_SIZE_MB=50
OCR_TEXT_DENSITY_THRESHOLD=60
